<mxfile host="drawio" type="device"><diagram name="Activity diagram - main loop" id="554355617"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style='font-size:18px'&gt;Activity diagram: time-step loop and agent loop&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Outer loop: one iteration per time step&lt;/b&gt;" style="rounded=0;html=1;dashed=1;fillColor=none;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1080" height="1520" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Inner loop: agents in shuffled order&lt;/b&gt;" style="rounded=0;html=1;dashed=1;fillColor=#FAFAFA;strokeColor=#6C8EBF;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="330" width="830" height="1020" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Agent.move(map, log)&lt;/b&gt; (polymorphic)" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#82B366;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="450" width="560" height="820" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="125" y="70" width="30" height="30" as="geometry"/></mxCell><mxCell id="c8" value="Initialise: map, SafeZones,&lt;br&gt;obstacles, 4 Masters (Singletons),&lt;br&gt;16 agents, 48 unique messages" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="c9" 