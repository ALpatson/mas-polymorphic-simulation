<mxfile host="drawio" type="device"><diagram name="Agent state machine" id="53971460"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style='font-size:18px'&gt;State-machine diagram: mobile agent (AgentState)&lt;/b&gt;" style="text;html=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="455" y="50" width="30" height="30" as="geometry"/></mxCell><mxCell id="c5" value="AT_HOME&lt;hr style='margin:2px'&gt;&lt;span style='font-size:11px;font-weight:normal'&gt;do / recoverEp()&lt;br&gt;entry / deliverToMaster()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="180" height="80" as="geometry"/></mxCell><mxCell id="c6" value="EXPLORING&lt;hr style='margin:2px'&gt;&lt;span style='font-size:11px;font-weight:normal'&gt;do / random path&lt;br&gt;(MovementStrategy)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="180" height="80" as="geometry"/></mxCell><mxCell id="c7" value="RETURNING&lt;hr style='margin:2px'&gt;&lt;span style='font-size:11px;font-weight:normal'&gt;do / BFS path home&lt;br&gt;(max 3 tiles per step)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="180" height="80" as="geometry"/></mxCell><mxCell id="c8" value="ENCOUNTER&lt;hr style='margin:2px'&gt;&lt;span style='font-size:11px;font-weight:normal'&gt;union / ally share /&lt;br&gt;rock-paper-scissors&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontStyle=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="180" height="80" as="geometry"/></mxCell><mxCell id="c9" value="EXHAUSTED&lt;hr style='margin:2px'&gt;&lt;span style='font-size:11px;font-weight:normal'&gt;acts as an obstacle&lt;br&gt;messages lost&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fontStyle=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="380" y="680" width="180" height="80" as="geometry"/></mxCell><mxCell id="c10" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="455" y="830" width="30" height="30" as="geometry"/></mxCell><mxCell id="c11" value="created in its SafeZone&lt;br&gt;EP = maxEp" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="[EP &amp;lt; 90%]&lt;br&gt;/ recoverEp()" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.2;entryX=0.8;entryY=0;" edge="1" parent="1" source="c5" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="136"/><mxPoint x="600" y="92"/><mxPoint x="524" y="92"/></Array></mxGeometry></mxCell><mxCell id="c13" value="[EP &amp;gt;= 90%]&lt;br&gt;leave home" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="160"/></Array></mxGeometry></mxCell><mxCell id="c14" value="move / spendEp(2 per tile)&lt;br&gt;enters own SafeZone&lt;br&gt;/ deliverToMaster()" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0;exitY=0.25;entryX=0.15;entryY=0;" edge="1" parent="1" source="c6" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="60" y="320"/><mxPoint x="60" y="262"/><mxPoint x="147" y="262"/></Array></mxGeometry></mxCell><mxCell id="c15" value="[EP &amp;lt; 20%]" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="enters own SafeZone&lt;br&gt;/ deliverToMaster()" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.5;exitY=0;entryX=1;entryY=0.75;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="180"/></Array></mxGeometry></mxCell><mxCell id="c17" value="agent on the path" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.75;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="504"/></Array></mxGeometry></mxCell><mxCell id="c18" value="resolved&lt;br&gt;[EP &amp;gt;= 20%]" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0;exitY=0.7;entryX=0.25;entryY=1;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="536"/></Array></mxGeometry></mxCell><mxCell id="c19" value="agent on the path" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0.25;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="685" y="504"/></Array></mxGeometry></mxCell><mxCell id="c20" value="resolved [EP &amp;lt; 20%&lt;br&gt;or was returning]" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.7;entryX=0.75;entryY=1;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="536"/></Array></mxGeometry></mxCell><mxCell id="c21" value="[EP = 0] or meteorite&lt;br&gt;/ exhaust()" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=0;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="368"/><mxPoint x="80" y="720"/></Array></mxGeometry></mxCell><mxCell id="c22" value="[EP = 0] or meteorite&lt;br&gt;/ exhaust()" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.85;entryX=1;entryY=0.3;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="368"/><mxPoint x="860" y="704"/></Array></mxGeometry></mxCell><mxCell id="c23" value="ally bumps into it&lt;br&gt;/ receiveEp(30% of max)" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;exitX=1;exitY=0.7;entryX=1;entryY=0.4;dashed=1;" edge="1" parent="1" source="c9" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="736"/><mxPoint x="1010" y="332"/></Array></mxGeometry></mxCell><mxCell id="c24" value="end of simulation" style="endArrow=open;endSize=10;html=1;rounded=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;ENCOUNTER is transient: it lasts during&lt;br&gt;one meeting, then the agent goes back&lt;br&gt;to the state it came from.&lt;br&gt;Thresholds come from Config:&lt;br&gt;LOW_EP_PERCENT = 20&lt;br&gt;LEAVE_HOME_PERCENT = 90&lt;br&gt;DONATION_PERCENT = 30" style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#F5F5F5;strokeColor=#999999;size=14;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="250" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>